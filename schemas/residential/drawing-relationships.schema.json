{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Optional relationship overlay for a classified drawing",
  "type": "object",
  "required": ["schema_version", "kind", "document_id", "review_status", "authoritative"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "drawing_relationships_overlay"},
    "document_id": {"type": "string"},
    "units": {"type": ["string", "null"]},
    "review_status": {"enum": ["unreviewed", "accepted", "rejected"]},
    "authoritative": {"type": "boolean"},
    "proximity_gap": {"type": ["number", "null"]},
    "host_wall_candidates": {"type": "array"},
    "access_candidates": {"type": "array"},
    "access_edges": {"type": "array", "items": {
      "type": "object",
      "required": ["opening_id", "space_ids", "review_status"],
      "properties": {
        "opening_id": {"type": "string"},
        "space_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "review_status": {"enum": ["unreviewed", "accepted", "rejected"]}
      }
    }},
    "dwelling_units": {"type": "array"},
    "common_areas": {"type": "array"},
    "interpretation": {"type": "string"}
  }
}
