{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 0 source-preserving normalized drawing",
  "type": "object",
  "required": ["schema_version", "document_id", "source_id", "source_ids", "source_group_id", "units", "layers", "entities", "flags"],
  "properties": {
    "schema_version": {"type": ["integer", "string"]},
    "document_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_group_id": {"type": "string", "minLength": 1},
    "units": {"enum": ["px", "mm", "unknown", "m", "cm"]},
    "layers": {"type": "array", "minItems": 32, "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
    "flags": {"type": "array", "items": {"$ref": "#/definitions/flag"}},
    "entities": {"type": "array", "items": {"type": "object", "required": ["id", "layer"], "properties": {
      "id": {"type": "string"}, "layer": {"type": "string"},
      "poly": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/polygon"}]},
      "polys": {"type": "array", "items": {"$ref": "#/definitions/polygon"}},
      "flags": {"type": "array", "items": {"$ref": "#/definitions/flag"}},
      "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "annotation_id", "annotation_index"]}}
    }}}
  },
  "definitions": {
    "polygon": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
    "flag": {"type": "object", "required": ["code", "reason", "blocking"], "properties": {"code": {"type": "string"}, "reason": {"type": "string"}, "blocking": {"type": "boolean"}}}
  }
}
