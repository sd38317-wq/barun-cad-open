{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unverified numeric OCR evidence in original image pixels",
  "type": "object",
  "required": ["schema_version", "method_version", "document_id", "source_ids", "identity_signature", "source_image_sha256", "status", "verified", "numeric_texts", "dimension_candidates", "consensus"],
  "properties": {
    "schema_version": {"const": 1},
    "method_version": {"const": "numeric-ocr-1"},
    "document_id": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "identity_signature": {"type": "string"},
    "source_image_sha256": {"type": "string"},
    "status": {"enum": ["processed", "failed"]},
    "verified": {"const": false},
    "numeric_texts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "bbox", "ocr_score", "source", "verified"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "ocr_score": {"type": "number", "minimum": 0, "maximum": 1},
          "source": {"const": "derived_ocr"},
          "verified": {"const": false}
        }
      }
    },
    "dimension_candidates": {"type": "array", "items": {
      "type": "object", "required": ["text_id", "axis", "measurement_points", "mm_per_pixel_candidate", "status"],
      "properties": {
        "text_id": {"type": "string"},
        "axis": {"enum": ["horizontal", "vertical"]},
        "measurement_points": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
        "mm_per_pixel_candidate": {"type": "number", "exclusiveMinimum": 0},
        "status": {"const": "review"}
      }
    }},
    "consensus": {
      "type": "object", "required": ["status", "factor_candidate", "verified"],
      "properties": {
        "status": {"enum": ["review", "ready_for_review"]},
        "factor_candidate": {"type": ["number", "null"]},
        "verified": {"const": false}
      }
    }
  }
}
