{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source-bound refinement resolution",
  "type": "object",
  "required": ["schema_version", "resolution_schema_version", "document_id", "source_ids", "status", "phase1_started"],
  "properties": {
    "schema_version": {"type": "integer"},
    "resolution_schema_version": {"const": 1},
    "document_id": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "status": {"enum": ["processed", "failed"]},
    "phase1_started": {"const": false},
    "dwelling_boundaries_verified": {"const": false},
    "classified": {"type": "object"},
    "input_unchanged": {"const": true},
    "transform_audit": {"type": "object", "required": ["passed", "checked_values"], "properties": {"passed": {"const": true}, "checked_values": {"type": "integer", "minimum": 0}}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "processed"}}}, "then": {"required": ["classified", "region_proposals", "scale_decisions", "transform_audit", "input_unchanged", "input_hashes", "scale_review_snapshot"]}, "else": {"required": ["review_layer", "reason"]}}]
}
