{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Attributable raster dimension review",
  "type": "object",
  "required": ["schema_version", "document_id", "source_ids", "source_image_sha256", "evidence_sha256", "status", "reviewer", "units", "unit_basis", "scope", "scope_basis", "dimensions"],
  "properties": {
    "schema_version": {"const": 1},
    "document_id": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_image_sha256": {"type": "string"},
    "evidence_sha256": {"type": "string"},
    "status": {"enum": ["accepted", "rejected", "pending"]},
    "reviewer": {"type": "string", "minLength": 1},
    "units": {"enum": ["mm", "unknown"]},
    "unit_basis": {"type": "string", "minLength": 1},
    "unit_basis_kind": {"type": "string"},
    "explicit_mm_legend": {"type": "boolean"},
    "dwelling_boundaries_verified": {"type": "boolean"},
    "inspection_image": {"type": "string"},
    "supersedes_visual_pending_record": {"type": "string"},
    "scope": {"enum": ["single_scale_whole_image", "region_review_required"]},
    "scope_basis": {"type": "string", "minLength": 1},
    "dimensions": {"type": "array", "items": {
      "type": "object", "required": ["candidate_index", "printed_mm", "text_confirmed", "endpoints_confirmed"],
      "properties": {
        "candidate_index": {"type": "integer", "minimum": 0},
        "printed_mm": {"type": "number", "exclusiveMinimum": 0},
        "text_confirmed": {"type": "boolean"},
        "endpoints_confirmed": {"type": "boolean"},
        "ocr_correction": {"type": "object", "required": ["original_text", "reviewed_text", "reason"], "properties": {
          "original_text": {"type": "string"}, "reviewed_text": {"type": "string"}, "reason": {"type": "string", "minLength": 1}
        }}
      }
    }}
  }
}
