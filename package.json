  "devDependencies": {
    "@tarikjabiri/dxf": "2.8.9",
    "clipper-lib": "6.4.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "makerjs": "0.19.2",
    "three": "0.186.0"
  },
  "main": "desktop.cjs",
  "description": "Local architectural CAD with DXF, PDF and Miri",
  "author": "Barun CAD",
  "license": "GPL-3.0-or-later",
  "build": {
    "appId": "kr.barun.cad",
    "productName": "Barun CAD",
    "directories": {
      "output": "installer"
    },
    "files": [
      "desktop.cjs",
      "desktop-startup.cjs",
      "desktop-startup.html",
      "desktop-http.cjs",
      "barun-cad-brand.png",
      "package.json",
      "desktop-preload.cjs",
      "desktop-lifecycle.cjs",
      "desktop-files.cjs",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "desktop-print.cjs"
    ],
    "fileAssociations": [
      {
        "ext": "dwg",
        "name": "DWG 도면",
        "description": "바른CAD DWG 도면",
        "role": "Editor"
      },
      {
        "ext": "dxf",
        "name": "DXF 도면",
        "description": "바른CAD DXF 도면",
        "role": "Editor"
      },
      {
        "ext": "bcad",
        "name": "바른CAD 도면",
        "description": "바른CAD 작업 도면",
        "role": "Editor"
      }
    ],
    "extraResources": [
      {
        "from": "desktop-backend/barun-cad-server",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "barun-cad.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "shortcutName": "바른 CAD",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://barunarc.co.kr/downloads/barun-cad/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sd38317-wq/barun-cad-open.git"
  }
}
